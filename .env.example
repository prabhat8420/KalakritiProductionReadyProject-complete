# Server Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME=Kalakriti
APP_URL=http://localhost:3000
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=change_this_to_a_secure_random_32_byte_hex_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_USER=kalakriti_user
POSTGRES_PASSWORD=kalakriti_secure_password
POSTGRES_DB=kalakriti_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://kalakriti_user:kalakriti_secure_password@localhost:5432/kalakriti_db
DATABASE_URL_SYNC=postgresql://kalakriti_user:kalakriti_secure_password@localhost:5432/kalakriti_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Integrations
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

CLOUDINARY_CLOUD_NAME=placeholder
CLOUDINARY_API_KEY=placeholder
CLOUDINARY_API_SECRET=placeholder

ANTHROPIC_API_KEY=placeholder
